# Database & Redis
DATABASE_URL="postgresql://govcalc:govcalc_secret@localhost:5432/govcalc?schema=public"
REDIS_URL="redis://localhost:6379"

# Application Ports & URLs
PORT=4000
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT & Auth
JWT_SECRET="govcalc_development_jwt_secret_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Calculation Engine Defaults
DEFAULT_BHM_AMOUNT="440000"
DEFAULT_CURRENCY="UZS"
